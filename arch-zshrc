export PATH=$HOME/bin:/usr/local/bin:$PATH
CASE_SENSITIVE="true"
# HYPHEN_INSENSITIVE="true"

plugins=(git sudo z fzf autojump command-not-found cp copypath copyfile history-substring-search zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.shexport ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="agnosterzak"

plugins=(
    git
    archlinux
    zsh-autosuggestions
    zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# Check archlinux plugin commands here
# https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/archlinux

# Display Pokemon-colorscripts
# Project page: https://gitlab.com/phoneybadger/pokemon-colorscripts#on-other-distros-and-mac>
#pokemon-colorscripts --no-title -s -r #without fastfetch
pokemon-colorscripts --no-title -s -r | fastfetch -c $HOME/.config/fastfetch/config-pokemon.j>

# fastfetch. Will be disabled if above colorscript was chosen to install
#fastfetch -c $HOME/.config/fastfetch/config-compact.jsonc

# Set-up icons for files/directories in terminal using lsd
alias ls='lsd'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'

# Set-up FZF key bindings (CTRL R for fuzzy history finder)
source <(fzf --zsh)

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
alias s="sudo"
alias sn="sudo shutdown now"
alias rb="sudo reboot"
alias add="sudo pacman -S"
alias del="sudo pacman -R"
alias purge="sudo pacman -Rsc"
alias clean="sudo pacman -Sc ; sudo pacman -Rns  '$(pacman -Qtdq)'"
alias update="sudo pacman -Syy"
alias upgrade="sudo pacman -Syyuu"
alias list="sudo pacman -Qe"
alias find="sudo pacman -Ss"
alias yay="yay -S --noconfirm"
alias makepkg="makepkg --si --noconfirm --skippgpcheck"

fastfetch
setopt nonomatch

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
source /usr/share/nvm/init-nvm.sh
